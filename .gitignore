# Build output. Anchored with a leading slash on purpose: a bare pattern also
# matches the cmd/claudemux-head/ SOURCE directory, silently ignoring every file
# a contributor adds there.
/claudemux-head
/claudemux

# Per-user project config. Contains op_env, an ID pointing at your secrets.
# Gitignored so that neither this repo nor any repo using claudemux can leak it.
# See .claudemux.yml.example for the format. .project.yml is the file's former
# name, still read as a fallback and still ignored so an unmigrated checkout
# cannot commit one by accident.
.claudemux.yml
.project.yml

# Local agent/process artifacts
.claude/settings.local.json
.claude/worktrees/
.superpowers/
