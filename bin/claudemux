#!/usr/bin/env bash
# Launch tmux sessions with a Claude Code environment.
# Usage: claudemux [-n] [-d] [-w|-W] [switch|setup|dir|query ...]
#
# Requires: tmux, claudemux-head (on PATH), git. Optional: op (1Password
# Environments), zoxide (directory-query resolution), iTerm2 (tab coloring).
#
# Each directory gets its own session named after the directory basename.
# Layout: claudemux-head is always a full-width, 4-row pane; `launch.layout`
# in config.yml then chooses where claude and the optional shell go —
# shell-right (default), no-shell, shell-bottom, or head-bottom. See
# create_session's layout comment block below for what each one looks like.
#
# A bare arg that isn't a directory is resolved via zoxide (`z`) history.
#
# Options:
#   -n   Create a new session even if one with the same name exists
#        (appends -2, -3, ... to the session name).
#   -d   Detached: create (or find) the session, print its name to stdout, and
#        exit instead of attaching. For callers already inside tmux — the
#        switchboard's `n` key runs `claudemux -n -d <query>` and then
#        switch-clients to the printed name.
#   -w   Mark this session as wanting a worktree regardless of config or repo
#        state.
#   -W   Never mark this session, whatever the config says.
#        -w/-W (and the auto_worktree heuristic below) only affect NEWLY
#        CREATED sessions — attaching to an existing session reuses whatever
#        claude command it was launched with, same as name/color. Combine
#        with -n to force a new session if you need -w/-W to take effect.
#
# This script does not create worktrees and no longer passes `claude
# --worktree`. It decides whether a session SHOULD have one and exports
# CLAUDEMUX_WORKTREE_PENDING; hooks/claudemux-worktree.sh then asks the model to
# create one named after the task on its first response. Creating it at launch
# meant naming it before any prompt existed. With launch.auto_worktree enabled
# in config.yml (or `worktree: true` in .claudemux.yml), a launch on a repo's
# default branch is marked automatically; feature branches, detached HEADs,
# linked worktrees, and non-repos are left alone.
#
# A session that is opened and never prompted therefore gets no worktree at all.

set -euo pipefail

FORCE_NEW=false
DETACHED=false
WORKTREE_MODE=""   # "" = decide from config; "force"/"skip" from -w/-W
worktree_mode_set() {
  if [ -n "$WORKTREE_MODE" ] && [ "$WORKTREE_MODE" != "$1" ]; then
    echo "claudemux: -w and -W are mutually exclusive" >&2
    exit 1
  fi
  WORKTREE_MODE="$1"
}
while getopts "ndwW" opt; do
  case "$opt" in
    n) FORCE_NEW=true ;;
    d) DETACHED=true ;;
    w) worktree_mode_set force ;;
    W) worktree_mode_set skip ;;
    *) echo "Usage: claudemux [-n] [-d] [-w|-W] [switch|setup|dir|query ...]" >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

# resolve_self — absolute path of this script with symlinks followed.
#
# Not `readlink -f "$0"`: BSD readlink gained -f only on macOS 12.3 (2022), so on
# older macOS it errors, $0 stays unresolved, and the color resolver beside the
# real script is never found — silently dropping project colors for a
# Homebrew/symlinked install. This pure-shell walk works everywhere; greadlink
# (GNU coreutils) is used when present as a fast path.
resolve_self() {
  if command -v greadlink >/dev/null 2>&1; then
    greadlink -f "$1"
    return
  fi
  local p="$1" t
  while [ -L "$p" ]; do
    t="$(readlink "$p")"
    case "$t" in
      /*) p="$t" ;;
      *)  p="$(dirname "$p")/$t" ;;
    esac
  done
  printf '%s/%s\n' "$(cd "$(dirname "$p")" && pwd)" "$(basename "$p")"
}

# Register the Claude Code pane-map hook if it is not already there.
#
# This is a no-op read when the hook is present, which is the common case. It
# lives here rather than only in the installers because Homebrew formulas must
# not write to ~/.claude — without this, every brew user would silently run with
# no hook and get wrong pane binding.
#
# Never fatal: a missing or unhappy hook costs accurate pane binding, not the
# session. Exit 3 (a settings.json that does not parse) and exit 4 (an I/O
# failure) are the two cases worth surfacing, because both mean we
# deliberately touched nothing: hook.go validates every shipped script's
# source path before copying any of them, so a single missing sibling (e.g.
# an incomplete install prefix) fails the whole `hook ensure` with rc=4
# rather than partially registering — otherwise-silent, since a missing
# claudemux-worktree.sh would also drop the already-working
# claudemux-map.sh hook with no visible sign.
ensure_hook() {
  command -v claudemux-head >/dev/null 2>&1 || return 0
  local err rc=0
  err="$(mktemp)"
  claudemux-head hook ensure >/dev/null 2>"$err" || rc=$?
  { [ "$rc" -eq 3 ] || [ "$rc" -eq 4 ]; } && cat "$err" >&2
  rm -f "$err"
  # Explicit: the `{ ... } && cat` above is the last command otherwise, and its
  # status would escape to `set -e` whenever rc is neither 3 nor 4 — killing
  # the launcher in the *common* case.
  return 0
}
ensure_hook

# resolve_dir QUERY — echo an existing directory for QUERY: itself if it's a
# real dir, otherwise the best zoxide match. Non-zero exit if unresolved.
resolve_dir() {
  local q="$1"
  if [ -d "$q" ]; then
    (cd "$q" && pwd)
    return 0
  fi
  if command -v zoxide >/dev/null 2>&1; then
    local hit
    hit="$(zoxide query -- "$q" 2>/dev/null || true)"
    if [ -n "$hit" ] && [ -d "$hit" ]; then
      echo "$hit"
      return 0
    fi
  fi
  return 1
}

# apply_status_color SESSION DIR — set SESSION's tmux status bar and active
# pane border style from the nearest project color (DIR and ancestors). fg
# auto-picks black/white by background luminance. tmux options, so they
# persist — set once at launch/attach, no focus hooks needed. Leaves the
# default style if no color.
apply_status_color() {
  local resolver style hex fg
  resolver="$(dirname "$(resolve_self "$0")")/project-color-resolve.sh"
  [ -f "$resolver" ] || return 0
  # shellcheck disable=SC1090
  . "$resolver"
  style="$(resolve_project_style "$2" 2>/dev/null || true)"
  [ -n "$style" ] || return 0
  hex="${style%% *}"
  fg="${style##* }"
  tmux set -t "$1" status-style "bg=#${hex},fg=${fg}"
  # pane-active-border-style is a window option; sessions here are single-window
  tmux set -w -t "$1" pane-active-border-style "fg=#${hex}"
}

# apply_tab_color DIR — set the iTerm2 tab color from the nearest project color
# (DIR and ancestors), written to the controlling terminal just before we
# exec-attach. Set once here (NOT via tmux focus hooks, which used to repaint
# every tab on each focus change). No-op if there's no /dev/tty or no color.
apply_tab_color() {
  [ -e /dev/tty ] || return 0
  local resolver hex r g b
  resolver="$(dirname "$(resolve_self "$0")")/project-color-resolve.sh"
  [ -f "$resolver" ] || return 0
  # shellcheck disable=SC1090
  . "$resolver"
  hex="$(resolve_project_hex "$1" 2>/dev/null || true)"
  [ -n "$hex" ] || return 0
  r=$((16#${hex:0:2})); g=$((16#${hex:2:2})); b=$((16#${hex:4:2}))
  printf '\033]6;1;bg;red;brightness;%d\a'   "$r" > /dev/tty
  printf '\033]6;1;bg;green;brightness;%d\a' "$g" > /dev/tty
  printf '\033]6;1;bg;blue;brightness;%d\a'  "$b" > /dev/tty
}

# attach SESSION DIR — paint the status bar + iTerm2 tab for DIR, then
# exec-attach SESSION.
attach() {
  # tmux's default status-left-length is 10, which truncates any session name
  # longer than 8 columns ("[claudemu"). Session names here are directory
  # basenames, so give them room. Set on every attach, not just creation, so
  # sessions that predate this fix pick it up too.
  tmux set -t "$1" status-left-length 32
  apply_status_color "$1" "$2"
  if [ "$DETACHED" = true ]; then
    # The caller wants the name, not the client. Tab color is skipped too:
    # this process's /dev/tty belongs to whatever pane invoked us (the
    # switchboard's, typically), and painting it here would color that tab
    # with the NEW project's color before any client has moved.
    printf '%s\n' "$1"
    exit 0
  fi
  apply_tab_color "$2" || true
  # Not `exec`: running tmux as a child lets the launcher — and the shell that
  # invoked it — regain control when the session ends and read our exit code.
  # Reaching here means the launch succeeded, so we report success (0)
  # regardless of the tmux client's own exit status; the shell wrapper uses
  # that 0 to close the terminal tab once the session is gone. A failure that
  # exits *before* attach leaves a non-zero code, keeping the tab (and its
  # error) on screen.
  tmux attach -t "$1"
  exit 0
}

# project_config_file DIR — echo the project config file to read from DIR: the
# current .claudemux.yml when it exists, else the legacy .project.yml. Always
# echoes a path; a project with neither gets the current name, which
# project_field then reads as "no such file", i.e. no declared values.
#
# The name preference is duplicated in two other readers — the ancestor walk in
# bin/project-color-resolve.sh and projectConfigPath in
# cmd/claudemux-head/projectconfig.go. Deliberate: this launcher stays
# self-contained rather than sourcing the resolver at top level, so a broken
# install that has lost the resolver still reads op_env, name and color instead
# of silently launching without them. Keep the three in step.
project_config_file() {
  if [ -f "$1/.claudemux.yml" ]; then
    echo "$1/.claudemux.yml"
  else
    echo "$1/.project.yml"
  fi
}

# project_field DIR KEY — echo the trimmed, unquoted value of a top-level
# `KEY: value` line from DIR's simple flat project config. Empty if absent.
project_field() {
  local file
  file="$(project_config_file "$1")"
  [ -f "$file" ] || return 0
  sed -n "s/^[[:space:]]*$2:[[:space:]]*//p" "$file" | head -1 \
    | sed -e 's/[[:space:]]*$//' -e "s/^[\"']//" -e "s/[\"']\$//"
}

# ch_config_get's out-parameters. Initialized because `set -u` aborts on the
# first read of an unset variable.
#
#   CH_CONFIG_VALUE — the value for the requested key, or "" if it has none.
#   CH_CONFIG_ERR   — non-empty once config.yml has been found to be malformed.
CH_CONFIG_VALUE=""
CH_CONFIG_ERR=""

# ch_config_get KEY — read claudemux-head's configured value for KEY into
# CH_CONFIG_VALUE (empty when the key is absent or the config is broken).
#
# It reports through variables rather than stdout **on purpose**: a caller
# writing `x="$(ch_config_get k)"` would run this in a subshell, and the
# CH_CONFIG_ERR bookkeeping — which is what keeps one broken config from being
# reported once per lookup — would be discarded with it. Assigning from a
# command substitution INSIDE the function is fine: only the binary runs in the
# subshell; the assignment and the error handling happen here.
#
# An absent key (exit 1) is the normal case — an org the user never configured —
# and stays silent. A malformed config.yml (exit 3) is NOT: re-emit claudemux-head's
# diagnostic, or a broken config degrades into an indistinguishable secrets-less
# launch. Always returns 0, so callers need no `|| true` under `set -e`.
ch_config_get() {
  local err rc=0
  err="$(mktemp)"
  CH_CONFIG_VALUE="$(claudemux-head config get "$1" 2>"$err")" || rc=$?
  if [ "$rc" -eq 3 ]; then
    # One broken file is one problem, however many keys we go on to ask for.
    [ -z "$CH_CONFIG_ERR" ] && cat "$err" >&2
    CH_CONFIG_ERR=1
  fi
  [ "$rc" -ne 0 ] && CH_CONFIG_VALUE=""
  rm -f "$err"
  return 0
}

# auto_worktree_wanted DIR — success when DIR should be automatically marked
# for a worktree: a git repo's MAIN checkout sitting on its default branch.
# Feature branches, detached HEADs, linked worktrees, and non-repos all say
# no — those are states the user chose, and a surprise worktree would fight
# them. Each check is one fast git subprocess; keep it that way, this runs on
# the launch path.
auto_worktree_wanted() {
  local dir="$1" branch default gitdirs
  command -v git >/dev/null 2>&1 || return 1
  [ "$(git -C "$dir" rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ] || return 1
  # A linked worktree's --git-dir sits under the main checkout's
  # .git/worktrees/<name>; only in the main checkout do the two coincide. Must
  # be a SINGLE call with --path-format=absolute (git >= 2.31, Mar 2021): run
  # separately, --git-dir prints relative-to-cwd while --git-common-dir prints
  # absolute, so from any subdirectory the two never textually match even in
  # the main checkout — the heuristic would wrongly decline there. On git
  # < 2.31 this call fails outright and the guard below degrades to "no
  # worktree", which is an acceptable miss (not a wrongly marked session).
  gitdirs="$(git -C "$dir" rev-parse --path-format=absolute --git-dir --git-common-dir 2>/dev/null)" || return 1
  [ "$(head -1 <<< "$gitdirs")" = "$(tail -1 <<< "$gitdirs")" ] || return 1
  branch="$(git -C "$dir" symbolic-ref --short -q HEAD)" || return 1 # detached
  default="$(git -C "$dir" symbolic-ref --short -q refs/remotes/origin/HEAD || true)"
  default="${default#origin/}"
  if [ -n "$default" ]; then
    [ "$branch" = "$default" ]
  else
    # No origin/HEAD (no remote, or never fetched): fall back to convention.
    [ "$branch" = "main" ] || [ "$branch" = "master" ]
  fi
}

# worktree_requested DIR — success when this launch should mark the session
# for a worktree. Precedence, highest first: -w/-W, `worktree:` in
# DIR/.claudemux.yml, launch.auto_worktree in config.yml. An explicit -w skips
# the appropriateness heuristic entirely — the user asked, and if DIR turns
# out not to be a repo, that surfaces later as a failed EnterWorktree
# mid-session plus a permanent "no worktree" chip, since `claude --worktree`
# is never passed here anymore. Both config sources are auto mode and go
# through auto_worktree_wanted.
worktree_requested() {
  local dir="$1" proj
  case "$WORKTREE_MODE" in
    force) return 0 ;;
    skip)  return 1 ;;
  esac
  proj="$(project_field "$dir" worktree)"
  case "$proj" in
    true)  auto_worktree_wanted "$dir"; return ;;
    false) return 1 ;;
  esac
  ch_config_get launch.auto_worktree
  [ "$CH_CONFIG_VALUE" = "true" ] || return 1
  auto_worktree_wanted "$dir"
}

# op_account_for DIR — the 1Password account for DIR's repo. Precedence:
#   1. explicit `op_account` in DIR/.claudemux.yml
#   2. onepassword.accounts.<github-org> from claudemux-head's config.yml
#   3. onepassword.default_account from the same
# An empty result is valid and expected: `op` then picks its own default account.
op_account_for() {
  local work_dir="$1" acct origin org
  acct="$(project_field "$work_dir" op_account)"
  if [ -n "$acct" ]; then
    echo "$acct"
    return 0
  fi

  origin="$(git -C "$work_dir" remote get-url origin 2>/dev/null || true)"
  org="$(sed -n 's#.*github\.com[:/]\([^/]*\)/.*#\1#p' <<< "$origin")"
  if [ -n "$org" ]; then
    ch_config_get "onepassword.accounts.$org"
    if [ -n "$CH_CONFIG_VALUE" ]; then
      echo "$CH_CONFIG_VALUE"
      return 0
    fi
    # A config.yml that does not parse resolves nothing, so asking it for a
    # second key would only re-fail — and re-print — for no new information.
    [ -n "$CH_CONFIG_ERR" ] && return 0
  fi

  ch_config_get onepassword.default_account
  printf '%s' "$CH_CONFIG_VALUE"
}

# inject_op_env SESSION DIR — if DIR's project config names a 1Password
# Environment (op_env), read it once and copy its variables into SESSION's
# tmux session environment. One authorization per session; panes spawned (or
# respawned) afterwards inherit, and claude/sub-agents never call op
# themselves. Returns 0 only when variables were injected — the caller
# (deferred_launch) then respawns the panes whose shells predate the
# injection. Multiline values are truncated at the first newline — keep
# those out of Environments.
inject_op_env() {
  local session="$1" work_dir="$2" env_id acct env_out line key
  env_id="$(project_field "$work_dir" op_env)"
  [ -n "$env_id" ] || return 1
  acct="$(op_account_for "$work_dir")"
  local -a acct_args=()
  [ -n "$acct" ] && acct_args=(--account "$acct")
  if ! env_out="$(op environment read "$env_id" "${acct_args[@]+"${acct_args[@]}"}")"; then
    echo "claudemux: op environment read $env_id failed; launching without secrets" >&2
    return 1
  fi
  while IFS= read -r line; do
    [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
    key="${line%%=*}"
    tmux set-environment -t "$session" "$key" "${line#*=}"
  done <<< "$env_out"
}

# pane_cmd PANE — PANE's current foreground command, "" if the pane is gone.
pane_cmd() {
  tmux display-message -p -t "$1" '#{pane_current_command}' 2>/dev/null || true
}

# run_in_pane PANE COMMAND — make PANE run COMMAND instead of a shell.
#
# Panes are created as shells and immediately replaced rather than being spawned
# with their command already attached, for two reasons. remain-on-exit has to be
# set on a pane that already exists: a command that fails instantly (a binary
# that is not on PATH) would otherwise take its pane down — and, for pane 0, the
# whole session — before the next tmux call in create_session runs, turning a
# missing binary into a cascade of "can't find pane" errors under set -e. And
# respawn-pane clears the pane's screen, its scrollback, and any alternate-screen
# state, so the shell that existed for those few milliseconds leaves no trace;
# nothing is attached yet, so it is never drawn in the first place.
#
# remain-on-exit=failed keeps a pane only when its program exits non-zero: a
# clean exit closes the pane, while a failure leaves the pane and its error
# message on screen instead of the pane silently vanishing. The `failed` value
# needs tmux >= 3.2 and an older tmux is not worth an error — it degrades to
# panes that vanish on failure, which is what they would have done anyway.
#
# COMMAND is prefixed with exec because tmux runs a pane command as
# `default-shell -c COMMAND`. Every shell in play execs a single simple command,
# so today this is belt and braces — but pane_current_command has to name the
# real program (the pane map claudemux-head follows, deferred_launch's guard
# below, and the teardown's exit-wait all read it), and exec makes that a
# guarantee rather than a shell implementation detail. It also means a COMMAND
# that ever grows a second statement will NOT report the program: `sh -c 'a; b'`
# leaves the shell as the process group leader.
run_in_pane() {
  tmux set -p -t "$1" remain-on-exit failed 2>/dev/null || true
  # No -c: respawn-pane keeps the pane's working directory, which is the
  # work_dir it was created with (verified) — the same assumption the shell
  # pane's respawn in deferred_launch has always made.
  tmux respawn-pane -k -t "$1" "exec $2"
}

# deferred_launch SESSION DIR CLAUDE_PANE SHELL_PANE CLAUDE_CMD HOLDER — finish
# an op_env launch off the critical path. `op environment read` costs ~25s of
# WALL TIME per call — 27.4s / 25.4s / 22.4s over three consecutive reads on op
# 2.38.1, fully authorized, of an Environment holding a SINGLE variable. Only
# ~38% of that is CPU (7.7s user + 5.3s sys of a 33.3s run); the rest is spent
# waiting. No auth prompt is involved, and there is no CLI session to warm, so
# every new session pays it again.
#
# It is NOT the cost of decryption, and measuring it that way is what made the
# previous version of this comment claim "~10s of pure CPU". On the same
# machine and account, `op item get` decrypts an ENTIRE item, secret fields
# included, in 0.81s wall / 0.12s CPU, and `op item list` pulls every item in
# the account in 7.0s wall / 0.25s CPU. Reading one variable out of an
# Environment burns ~100x the CPU of decrypting a whole item. The `environment`
# subcommand is simply pathological (reproduced on op 2.38.1-beta.01 and
# 2.38.2-beta.01); the fix is to stop using Environments for launch-critical
# secrets, not to shave this code path. create_session
# backgrounds this and attaches immediately instead of leaving the user at a
# blank terminal for half a minute.
#
# Once the secrets are in the session environment, the shell pane is respawned
# so its shell inherits them — but only while it is still sitting on the
# foreground command it spawned with, so a pane the user has already started
# something in is left alone. The head pane is never respawned: claudemux-head
# deliberately does not read the monitored project's env (see
# summarizerEnvOptions).
#
# The claude pane is respawned WITH the claude command, which replaces the
# holding TUI in a single call: no shell, nothing typed, and the new process
# inherits the injected environment. Its guard cannot sample the pane the way
# the shell pane's does — tmux spawns a pane command through `default-shell -c`,
# so for a few milliseconds after run_in_pane the pane still reports the shell
# rather than the holder, and a sample taken then would never match the reading
# 25 seconds later; the launch would be silently dropped. It compares against
# HOLDER, the command create_session put there, instead. The old guarantee,
# stated rather than inferred: still the holder means the pane is ours to
# replace; already claude (the holder's own timeout or a keypress got there
# first) means it is neither killed nor double-launched; anything else is not
# ours. A holder that CRASHED still reports its command — tmux keeps
# pane_current_command on a dead pane — so the respawn fires over the corpse and
# the session still gets its claude.
#
# Runs as a background job with stdout/stderr discarded — anything written
# here would scribble over the attached tmux client — so failure is surfaced
# via display-message instead, and claude still launches (without secrets),
# matching the old synchronous behavior.
deferred_launch() {
  local session="$1" work_dir="$2" claude_pane="$3" shell_pane="$4" claude_cmd="$5" holder="$6"
  local shell_cmd0=""
  # shell_pane is "" in the no-shell layout — pane_cmd's own `2>/dev/null ||
  # true` would swallow a bad `-t ""` target anyway, but skipping the calls
  # outright is what keeps "no shell pane" and "shell pane that vanished"
  # distinguishable without relying on tmux's handling of an empty target.
  if [ -n "$shell_pane" ]; then
    shell_cmd0="$(pane_cmd "$shell_pane")"
  fi
  if inject_op_env "$session" "$work_dir"; then
    if [ -n "$shell_pane" ] && [ -n "$shell_cmd0" ] && [ "$(pane_cmd "$shell_pane")" = "$shell_cmd0" ]; then
      tmux respawn-pane -k -t "$shell_pane"
    fi
  else
    tmux display-message -t "$claude_pane" \
      'claudemux: 1Password environment failed — starting claude without secrets' || true
  fi
  if [ "$(pane_cmd "$claude_pane")" = "$holder" ]; then
    tmux respawn-pane -k -t "$claude_pane" "exec $claude_cmd"
  fi
  return 0
}

# maybe_onboard — run claudemux-head's interactive layout picker, once, when
# this looks like a first run: `claudemux-head` is on PATH, stdin AND stdout
# are both TTYs (a non-interactive caller — the switchboard's `n` prompt,
# which shells out through `claudemux -d`, or any scripted invocation — must
# never be handed a TUI), $DETACHED is false (same reason: `-d` callers want
# a session name on stdout, not a picker stealing the terminal), and
# `launch.layout` reads back empty with exit 0. That last check goes through
# ch_config_get rather than a raw `claudemux-head config get` call so a
# config.yml that fails to parse degrades to "skip onboarding, launch
# proceeds" — ch_config_get already prints the diagnostic once — instead of
# this function trying to interpret the failure itself.
#
# A cancelled (exit 1) or failed (exit 3) onboard is non-fatal: the launch
# continues on the default layout either way, same as if nothing had been
# offered. ONBOARD_ATTEMPTED guards against firing twice in one invocation —
# both the no-args path and the argument path below call this, but they are
# mutually exclusive branches today; the guard is what keeps that true if a
# future call site is ever added rather than relying on that being an accident
# of the current control flow.
ONBOARD_ATTEMPTED=false
maybe_onboard() {
  [ "$ONBOARD_ATTEMPTED" = false ] || return 0
  ONBOARD_ATTEMPTED=true
  command -v claudemux-head >/dev/null 2>&1 || return 0
  { [ -t 0 ] && [ -t 1 ]; } || return 0
  [ "$DETACHED" = false ] || return 0
  ch_config_get launch.layout
  { [ -z "$CH_CONFIG_ERR" ] && [ -z "$CH_CONFIG_VALUE" ]; } || return 0
  claudemux-head onboard || true
  return 0
}

# session_title_name DECLARED_NAME SESSION_NAME CLONE_SUFFIX — the project's
# name as the terminal titlebar should show it. It mirrors restoreName
# (cmd/claudemux-head/tabreset.go) so a titlebar and a tab that has just been
# reset with `r` agree on what this project is called: the .claudemux.yml
# `name:` when one is declared, otherwise the session name, which is already
# unique. Clones (`claudemux -n`) share one .claudemux.yml, so the suffix that
# made the session name unique rides along onto the declared name — "Remix 2",
# rather than four titlebars all reading "Remix".
#
# Every "#" is doubled. The result is spliced into a tmux FORMAT string, where a
# lone "#" opens a directive (#W, #S, #{...}) and would otherwise swallow the
# character after it.
session_title_name() {
  local declared="$1" session="$2" suffix="$3" name="$2"
  if [ -n "$declared" ]; then
    name="$declared"
    [ -n "$suffix" ] && name="$declared $suffix"
  fi
  printf '%s' "${name//#/##}"
}

create_session() {
  local work_dir="$1"
  local session_name clone_suffix=""
  session_name="$(basename "$work_dir")"

  if tmux has-session -t "=$session_name" 2>/dev/null; then
    if [ "$FORCE_NEW" = true ]; then
      local i=2
      while tmux has-session -t "=${session_name}-${i}" 2>/dev/null; do
        ((i++))
      done
      session_name="${session_name}-${i}"
      # Kept for the titlebar: it is the one place that pairs the suffix with
      # the *declared* name, which carries no suffix of its own. attach() below
      # exits, so reaching past this branch means the suffix is the whole story
      # of how this session name differs from the directory basename.
      clone_suffix="$i"
    else
      attach "$session_name" "$work_dir"
    fi
  fi

  # Project metadata (.claudemux.yml: color + name), passed to claude at launch:
  # name via -n, color as a "/color X" prompt argument. No post-startup
  # send-keys — typing into the pane during boot used to collide with it.
  local proj_color proj_name claude_cmd claude_bin worktree_env
  proj_color="$(project_field "$work_dir" color)"
  proj_name="$(project_field "$work_dir" name)"
  # Absolute path when one can be resolved. The panes below are spawned with a
  # command, and tmux runs a pane command through a NON-interactive shell: it
  # never sources the rc file that put ~/.local/bin on PATH, and the environment
  # it does inherit is the tmux server's, which can predate that PATH entirely.
  # The launcher's own environment IS the user's interactive one, so resolving
  # here is better informed than resolving in the pane. Falling back to the bare
  # name is not merely a safety net: a `claude` that is a shell function or alias
  # exists only inside the shell, and bash's `command -v` cannot see a fish
  # function — leaving the name unresolved is what lets that keep working.
  claude_bin="$(command -v claude || true)"
  claude_cmd="$(printf '%q' "${claude_bin:-claude}") --permission-mode auto"
  [ -n "$proj_name" ] && claude_cmd+=" -n $(printf '%q' "$proj_name")"
  [ -n "$proj_color" ] && claude_cmd+=" $(printf '%q' "/color $proj_color")"
  # A marked session creates its worktree on its FIRST RESPONSE, not at launch:
  # hooks/claudemux-worktree.sh sees this variable, sees a cwd that is not yet a
  # worktree, and asks the model to call EnterWorktree with a name derived from
  # the prompt. `claude --worktree` cannot do that — it names the worktree during
  # startup, before any prompt exists, which is why every worktree used to be
  # called something like "lovely-wandering-lovelace".
  #
  # The head gets it too, so it can show `⚠ no worktree` if the first turn ends
  # with the session still in the main checkout.
  #
  # This retires the ordering constraint that used to live here: `--worktree
  # [name]` takes an optional value, so appended anywhere before the "/color X"
  # prompt argument it swallowed the prompt as a (rejected) worktree name and the
  # launch died. An env prefix has no such hazard, and appends to claude_cmd are
  # no longer ordered. Keep the hazard in mind if --worktree is ever reinstated.
  #
  # `env VAR=val`, not a bare `VAR=val`: run_in_pane wraps its argument as
  # `exec $2`, and a bare assignment sitting right after `exec` is parsed as
  # the program name, not as an assignment — `exec CLAUDEMUX_WORKTREE_PENDING=1
  # claude` tries to execute a file literally called `CLAUDEMUX_WORKTREE_PENDING=1`
  # and fails in every shell tried (bash, zsh, sh, dash, fish). `exec env
  # VAR=val cmd` is valid everywhere, fish included, because env(1) parses its
  # own leading VAR=val arguments regardless of how it was invoked.
  worktree_env=""
  if worktree_requested "$work_dir"; then
    worktree_env="env CLAUDEMUX_WORKTREE_PENDING=1 "
  fi
  claude_cmd="${worktree_env}${claude_cmd}"

  # claudemux-head (4 rows: first prompt, last prompt, state line, meters) is
  # ALWAYS full window width and exactly 4 rows — the four `launch.layout`
  # values (config.go's legalLayouts; empty/unrecognized here defaults to
  # shell-right, defense only, the head validates) only move it and the
  # optional shell:
  #   shell-right (default) — head across the top; claude below it; shell
  #     30% wide on the right.
  #   no-shell    — head across the top; claude below it; no shell pane.
  #   shell-bottom — head across the top; claude in the middle; shell 20%
  #     tall across the bottom.
  #   head-bottom — claude and shell side by side on top; head full-width
  #     across the bottom.
  # Track panes by ID — the short head pane never sits at a fixed positional
  # index across layouts, so positional indices would shift under us.
  #
  # Pane creation ORDER is what makes the head full width without a
  # split-window -f: `split-window -v [-b] -l 4` run while the window still
  # has a single column spans the whole width; run it after the claude|shell
  # split instead and it would only span claude's column. So in every layout
  # the head is split off claude FIRST, and the shell (if any) SECOND.
  #
  # The head and claude panes RUN their program (run_in_pane); only the shell
  # pane is a shell. Typing into a shell with send-keys was visible work: the
  # pane came up as an interactive shell, the user watched a prompt appear, a
  # command get typed, and — on the op_env path — an echoed notice scroll past
  # with a second prompt underneath it, all before anything started. A pane
  # created with a command never draws a prompt at all, so there is nothing to
  # hide.
  local layout claude_pane head_pane shell_pane head_bin holder_cmd
  ch_config_get launch.layout
  layout="$CH_CONFIG_VALUE"
  case "$layout" in
    shell-right | no-shell | shell-bottom | head-bottom) ;;
    *) layout="shell-right" ;;
  esac
  head_bin="$(command -v claudemux-head || true)"
  head_bin="${head_bin:-claudemux-head}"
  tmux new-session -d -s "$session_name" -c "$work_dir" -x "$(tput cols)" -y "$(tput lines)"
  claude_pane="$(tmux display-message -p -t "$session_name:0.0" '#{pane_id}')"
  shell_pane=""
  case "$layout" in
    shell-right)
      head_pane="$(tmux split-window -v -b -l 4 -t "$claude_pane" -c "$work_dir" -P -F '#{pane_id}')"
      shell_pane="$(tmux split-window -h -l '30%' -t "$claude_pane" -c "$work_dir" -P -F '#{pane_id}')"
      ;;
    no-shell)
      head_pane="$(tmux split-window -v -b -l 4 -t "$claude_pane" -c "$work_dir" -P -F '#{pane_id}')"
      ;;
    shell-bottom)
      head_pane="$(tmux split-window -v -b -l 4 -t "$claude_pane" -c "$work_dir" -P -F '#{pane_id}')"
      shell_pane="$(tmux split-window -v -l '20%' -t "$claude_pane" -c "$work_dir" -P -F '#{pane_id}')"
      ;;
    head-bottom)
      head_pane="$(tmux split-window -v -l 4 -t "$claude_pane" -c "$work_dir" -P -F '#{pane_id}')"
      shell_pane="$(tmux split-window -h -l '30%' -t "$claude_pane" -c "$work_dir" -P -F '#{pane_id}')"
      ;;
  esac
  run_in_pane "$head_pane" "${worktree_env}$(printf '%q' "$head_bin")"

  # With an op_env, claude's launch is handed to a background injector so the
  # attach below happens NOW rather than after op's ~25s decryption (see
  # deferred_launch). The pane is held by `claudemux-head boot`, a real TUI that
  # says what is being waited on and keeps a clock running against the typical
  # duration — a wait this long needs to show it is alive — and deferred_launch
  # replaces it with claude itself. The holder is handed the very same command
  # after `--`: it execs it if it is left waiting past its own timeout or the
  # user presses a key, so this pane ends up running claude however the wait
  # ends.
  if [ -n "$(project_field "$work_dir" op_env)" ]; then
    holder_cmd="$(printf '%q' "$head_bin") boot"
    holder_cmd+=" --project $(printf '%q' "$session_name")"
    holder_cmd+=" --label 'Unlocking 1Password environment'"
    # LAST: parseBootArgs (cmd/claudemux-head/boot.go) splits `boot`'s argument
    # list at the FIRST "--" it sees, flags before, command after — so
    # everything from here on is what the holder execs, verbatim, and a flag
    # placed after this point would be read as part of that command instead.
    holder_cmd+=" --expected 25s -- $claude_cmd"
    run_in_pane "$claude_pane" "$holder_cmd"
    deferred_launch "$session_name" "$work_dir" "$claude_pane" "$shell_pane" \
      "$claude_cmd" "$(basename "$head_bin")" >/dev/null 2>&1 &
  else
    run_in_pane "$claude_pane" "$claude_cmd"
  fi
  tmux select-pane -t "$claude_pane"

  # Pin the head pane to exactly 4 rows. The `-l 4` at split time does NOT
  # survive attach: with window-size=latest, attaching a client whose size
  # differs from the tput-derived new-session size makes tmux redistribute
  # pane heights proportionally, shrinking the head pane below 4 (losing the
  # prompt lines and/or statusbar). A window-resized hook re-pins it to 4 on
  # every resize — the attach included — so all four rows always render.
  tmux set-hook -t "$session_name" window-resized "resize-pane -t $head_pane -y 4"

  # Let the terminal tab track the tmux window name — claudemux-head renames the
  # window to the Haiku `tab` label as the session's focus settles. Set here so
  # the user needs no ~/.tmux.conf change.
  #
  # The project rides in front of the label so a titlebar names its project
  # before any label has landed, and so two sessions that settle on the same
  # topic stay tellable apart from the window list. Only the titlebar gets the
  # prefix — the window name itself stays the bare label, so the tmux status
  # line does not spend width repeating a session name that already sits a
  # column to its left.
  tmux set -t "$session_name" set-titles on
  tmux set -t "$session_name" set-titles-string \
    "$(session_title_name "$proj_name" "$session_name" "$clone_suffix") · #W"

  attach "$session_name" "$work_dir"
}

# open_switchboard — the switchboard: a lobby session whose pane runs
# `claudemux-head switchboard`, auto-ferrying the attached client to sessions
# waiting on input. The pane runs the program directly via exec (no shell),
# matching the head/claude panes: exiting the switchboard closes the pane, and
# exec guarantees pane_current_command reads claudemux-head rather than
# relying on sh's exec optimization. A project directory literally named
# "switchboard" collides with this session name: if a project session named
# "switchboard" already exists, `claudemux switch` attaches to that project
# session instead and no switchboard ever runs (first-wins) — see the
# exact-match guard in create_session for the other half of this hazard.
#
# `switch` and `setup` are reserved words in their own right: both are
# matched against $1 below before any directory or zoxide resolution runs, so
# a project directory literally named "switch" or "setup" can never be
# reached by `claudemux switch`/`claudemux setup` — cd into it and run bare
# `claudemux`, or pass a path (`claudemux ./switch`), instead.
open_switchboard() {
  local head_bin tab_color_helper
  head_bin="$(command -v claudemux-head || true)"
  head_bin="${head_bin:-claudemux-head}"
  if ! tmux has-session -t '=switchboard' 2>/dev/null; then
    tmux new-session -d -s switchboard "exec $head_bin switchboard"
  fi
  # prefix+S is the skip key: returning to the lobby is the switchboard's skip
  # gesture (the conductor snoozes the session you left and advances), so a
  # one-chord jump back to the lobby from anywhere completes the loop. Bound on
  # every `claudemux switch`, not just session creation, so it survives a tmux
  # server restart — but never over a binding the user set themselves: once
  # prefix+S is taken (by us or by them), it is left alone.
  #
  # The check greps the full prefix table: `list-keys -T prefix S` looks like
  # the obvious probe but exits 0 with no output for bound AND unbound keys
  # (observed on tmux 3.7b), so it cannot distinguish the two.
  if ! tmux list-keys -T prefix 2>/dev/null \
      | grep -qE '^bind-key([[:space:]]+-r)?[[:space:]]+-T[[:space:]]+prefix[[:space:]]+S([[:space:]]|$)'; then
    tmux bind-key S switch-client -t '=switchboard'
  fi
  # Follow the client with the iTerm2 tab color: client-session-changed fires
  # once per client switch — conductor escort, prefix+S skip, and manual
  # prefix+s alike — and the helper paints only that client's tab, via its
  # tty. This is NOT the retired focus-hook repaint (which redrew every tab on
  # each focus change); see apply_tab_color. Global and idempotent; -b so a
  # slow resolver never blocks tmux.
  tab_color_helper="$(dirname "$(resolve_self "$0")")/claudemux-tab-color"
  if [ -x "$tab_color_helper" ]; then
    tmux set-hook -g client-session-changed \
      "run-shell -b '$tab_color_helper \"#{client_tty}\" \"#{session_path}\"'"
  fi
  # -d's documented contract (see the option's help text above) is "create (or
  # find) the session, print its name to stdout, and exit instead of
  # attaching" — the switchboard is a session like any other, so it honors
  # that the same way create_session's attach does. This must come before the
  # attach/switch-client below, and after the lobby exists and its hooks are
  # wired, so `claudemux switch -d` (which reaches open_switchboard the same
  # way) behaves identically to bare `claudemux -d`.
  if [ "$DETACHED" = true ]; then
    printf '%s\n' switchboard
    exit 0
  fi
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t '=switchboard'
  fi
  tmux attach -t '=switchboard'
  exit 0
}

# `claudemux switch` opens the switchboard directly (see open_switchboard's
# header comment for the reserved-word/directory-collision hazard this and
# `setup` share).
if [ "${1:-}" = "switch" ]; then
  open_switchboard
fi

# `claudemux setup` — claudemux-head's interactive layout picker, run
# directly on this terminal with no tmux session involved. Just an exec: the
# picker's own exit status (0 saved, 1 cancelled, 3 save failure or a broken
# TUI) becomes claudemux's. Guarded by `command -v` like open_switchboard and
# create_session's head_bin resolution — without it, a missing binary would
# surface as bash's raw "command not found" (127) instead of a
# claudemux-voiced error.
if [ "${1:-}" = "setup" ]; then
  if ! command -v claudemux-head >/dev/null 2>&1; then
    echo "claudemux: claudemux-head not found on PATH — install it to run the layout picker" >&2
    exit 1
  fi
  exec claudemux-head onboard
fi

# Bare claudemux ALWAYS means the switchboard now — no attach-sole-session,
# no create-in-$PWD. maybe_onboard runs first so a first-time user is offered
# a layout choice before ever landing in the lobby; a cancelled or failed
# onboard just means every session launched from here on uses the default
# layout until `claudemux setup` is run by hand.
if [ "$#" -eq 0 ]; then
  maybe_onboard
  open_switchboard
fi

# Each argument becomes (or reattaches to) its own session. maybe_onboard runs
# once before the loop, for the same first-run reason as the no-args branch
# above — this is the path a first-time `claudemux <dir>` takes without ever
# passing through the switchboard. The first arg that resolves calls
# create_session, which attaches and never returns; unresolved args are
# reported and skipped. Falling through the loop means nothing resolved —
# exit non-zero so the shell wrapper keeps this message visible instead of
# closing the tab on a "successful" no-op.
maybe_onboard
for arg in "$@"; do
  if dir="$(resolve_dir "$arg")"; then
    create_session "$dir"
  else
    echo "claudemux: '$arg' is not a directory and has no zoxide match" >&2
  fi
done
exit 1
